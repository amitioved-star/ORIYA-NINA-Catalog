# Supabase — get these from your Supabase project → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Admin password — change this to a strong password!
VITE_ADMIN_PASSWORD=your_secure_password_here

# Analytics — GA4 measurement ID (loaded by index.html; this is an override).
VITE_GA_MEASUREMENT_ID=G-JKLZYEZXQT

# Google Ads — leave blank until conversion actions are created in Google Ads.
# Set VITE_GOOGLE_ADS_ID to your AW-XXXXXXXXX ID, then fill the labels for the
# conversion actions you want to track.
VITE_GOOGLE_ADS_ID=
VITE_ADS_LABEL_WHATSAPP=
VITE_ADS_LABEL_PHONE=
VITE_ADS_LABEL_MEASUREMENT=
VITE_ADS_LABEL_CONTACT=
